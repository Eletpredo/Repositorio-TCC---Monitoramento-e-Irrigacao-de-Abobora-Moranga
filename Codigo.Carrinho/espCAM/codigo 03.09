#include <Arduino.h>
#include "esp_camera.h"
#include <WiFi.h>
#include <WebServer.h>
#include <HTTPClient.h>

// ==========================================
// Credenciais da Rede Wi-Fi
// ==========================================
const char *ssid = "Note_natalia/pedro";
const char *password = "21011997";

// IP da ESP32 DevKit (Altere para o IP exato exibido no Serial do robô)
const char* url_robo = "192.168.137.103";

int i = 0;

// Mapeamento de Pinos - AI-THINKER ESP32-CAM
#define PWDN_GPIO_NUM     32
#define RESET_GPIO_NUM    -1
#define XCLK_GPIO_NUM      0
#define SIOD_GPIO_NUM     26
#define SIOC_GPIO_NUM     27
#define Y9_GPIO_NUM       35
#define Y8_GPIO_NUM       34
#define Y7_GPIO_NUM       39
#define Y6_GPIO_NUM       36
#define Y5_GPIO_NUM       21
#define Y4_GPIO_NUM       19
#define Y3_GPIO_NUM       18
#define Y2_GPIO_NUM        5
#define VSYNC_GPIO_NUM    25
#define HREF_GPIO_NUM     23
#define PCLK_GPIO_NUM     22
#define FLASH_GPIO_NUM     4 

WebServer server(80);

// ==========================================
// Comunicação HTTP com o Robô
// ==========================================
void notificarRobo() {
  if (WiFi.status() == WL_CONNECTED) {
    HTTPClient http;
    http.begin(url_robo);
    
    int httpCode = http.GET();
    if (httpCode > 0) {
      Serial.printf("Comando enviado ao robô com sucesso! Código HTTP: %d\n", httpCode);
    } else {
      Serial.printf("Falha ao notificar o robô, erro: %s\n", http.errorToString(httpCode).c_str());
    }
    http.end();
  } else {
    Serial.println("Erro: Wi-Fi desconectado ao tentar notificar o robô.");
  }
}

// Rota acionada para capturar foto e avisar a placa DevKit
void handleTirarFoto() {
  Serial.println("Solicitação de captura recebida. Tirando foto...");
  
  camera_fb_t * fb = esp_camera_fb_get();
  if (fb) {
    esp_camera_fb_return(fb); // Libera a memória da foto capturada
    
    // Responde ao cliente que fez a requisição
    server.send(200, "text/plain", "Foto capturada com sucesso!");
    Serial.println("Foto tirada! Enviando sinal para o robô...");
    
    // Notifica a ESP32 DevKit
    notificarRobo();
  } else {
    server.send(500, "text/plain", "Erro ao capturar foto.");
    Serial.println("Falha na captura da imagem.");
  }
}

// Transmissão do vídeo AO VIVO (MJPEG Stream)
void handleStream() {
  WiFiClient client = server.client();
  
  String response = "HTTP/1.1 200 OK\r\n";
  response += "Access-Control-Allow-Origin: *\r\n";
  response += "Content-Type: multipart/x-mixed-replace; boundary=frame\r\n\r\n";
  server.sendContent(response);

  while (client.connected()) {
    camera_fb_t * fb = esp_camera_fb_get();
    if (!fb) {
      Serial.println("Falha ao capturar frame do vídeo");
      break;
    }

    String partHeader = "--frame\r\nContent-Type: image/jpeg\r\nContent-Length: " + String(fb->len) + "\r\n\r\n";
    
    client.write(partHeader.c_str(), partHeader.length());
    client.write(fb->buf, fb->len);
    client.write("\r\n", 2);

    esp_camera_fb_return(fb);
    delay(10);
  }
}

// Foto única estática para visualização no navegador
void handleJpg() {
  camera_fb_t * fb = esp_camera_fb_get();
  if (!fb) {
    server.send(500, "text/plain", "Falha na captura da imagem");
    return;
  }
  
  server.sendHeader("Content-Type", "image/jpeg");
  server.sendHeader("Content-Length", String(fb->len));
  server.sendHeader("Access-Control-Allow-Origin", "*");
  
  WiFiClient client = server.client();
  client.write(fb->buf, fb->len);
  esp_camera_fb_return(fb);
}

// Liga/Desliga o Flash
void handleFlash() {
  static bool state = false;
  state = !state;
  digitalWrite(FLASH_GPIO_NUM, state ? HIGH : LOW);
  server.send(200, "text/plain", state ? "Flash LIGADO" : "Flash DESLIGADO");
}

void setup() {
  Serial.begin(115200);
  delay(2000);

  Serial.println("\n--- INICIALIZANDO ESP32-CAM ---");
  pinMode(FLASH_GPIO_NUM, OUTPUT);

  camera_config_t config;
  config.ledc_channel = LEDC_CHANNEL_0;
  config.ledc_timer = LEDC_TIMER_0;
  config.pin_d0 = Y2_GPIO_NUM;
  config.pin_d1 = Y3_GPIO_NUM;
  config.pin_d2 = Y4_GPIO_NUM;
  config.pin_d3 = Y5_GPIO_NUM;
  config.pin_d4 = Y6_GPIO_NUM;
  config.pin_d5 = Y7_GPIO_NUM;
  config.pin_d6 = Y8_GPIO_NUM;
  config.pin_d7 = Y9_GPIO_NUM;
  config.pin_xclk = XCLK_GPIO_NUM;
  config.pin_pclk = PCLK_GPIO_NUM;
  config.pin_vsync = VSYNC_GPIO_NUM;
  config.pin_href = HREF_GPIO_NUM;
  config.pin_sscb_sda = SIOD_GPIO_NUM;
  config.pin_sscb_scl = SIOC_GPIO_NUM;
  config.pin_pwdn = PWDN_GPIO_NUM;
  config.pin_reset = RESET_GPIO_NUM;
  config.xclk_freq_hz = 20000000;
  config.pixel_format = PIXFORMAT_JPEG;

  if (psramFound()) {
    config.frame_size = FRAMESIZE_VGA;
    config.jpeg_quality = 12;
    config.fb_count = 2;
  } else {
    config.frame_size = FRAMESIZE_CIF;
    config.jpeg_quality = 12;
    config.fb_count = 1;
  }

  esp_err_t err = esp_camera_init(&config);
  if (err != ESP_OK) {
    Serial.printf("Falha ao inicializar a câmera: 0x%x\n", err);
    return;
  }

  WiFi.begin(ssid, password);
  WiFi.setSleep(false);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
    i++;
    if (i >= 25) {
      Serial.println("\nImpossível conectar à internet!");
      break;
    }
  }

  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\nWi-Fi Conectado!");
    Serial.print("IP da ESP32-CAM: ");
    Serial.println(WiFi.localIP());
  }

  // Definição das Rotas do Servidor Web
  server.on("/tirar_foto", handleTirarFoto); // Tira foto e avisa o robô
  server.on("/stream", handleStream);        // Vídeo ao vivo
  server.on("/cam.jpg", handleJpg);          // Foto estática
  server.on("/flash", handleFlash);          // Ligar/Desligar LED Flash
  
  server.begin();
}

void loop() {
  server.handleClient();
}
