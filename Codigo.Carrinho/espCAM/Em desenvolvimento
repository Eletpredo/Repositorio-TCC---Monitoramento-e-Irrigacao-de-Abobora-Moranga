#include <Arduino.h>
#include "esp_camera.h"
#include <WiFi.h>
#include "esp_http_server.h"
#include "BluetoothSerial.h"

// --- CONFIGURAÇÃO WI-FI ---
const char* ssid = "Galaxy A11 de Gabriel C. S.";
const char* password = "Gabriel2209";

// --- CONFIGURAÇÃO BLUETOOTH ---
BluetoothSerial SerialBT;
String nomeRoboBT = "ESP32_Carrinho_Robo";

// --- MAPEAMENTO DE PINOS (AI THINKER) ---
#define PWDN_GPIO_NUM     32
#define RESET_GPIO_NUM    -1
#define XCLK_GPIO_NUM      0
#define SIOD_GPIO_NUM     26
#define SIOC_GPIO_NUM     27
#define Y9_GPIO_NUM       35
#define Y8_GPIO_NUM       34
#define Y7_GPIO_NUM       39
#define Y6_GPIO_NUM       36
#define Y5_GPIO_NUM       21
#define Y4_GPIO_NUM       19
#define Y3_GPIO_NUM       18
#define Y2_GPIO_NUM        5
#define VSYNC_GPIO_NUM    25
#define HREF_GPIO_NUM     23
#define PCLK_GPIO_NUM     22

// Protocolo MJPEG
#define PART_BOUNDARY "123456789000000000000987654321"
static const char* _STREAM_CONTENT_TYPE = "multipart/x-mixed-replace;boundary=" PART_BOUNDARY;
static const char* _STREAM_BOUNDARY = "\r\n--" PART_BOUNDARY "\r\n";
static const char* _STREAM_PART = "Content-Type: image/jpeg\r\nContent-Length: %u\r\n\r\n";

httpd_handle_t stream_httpd = NULL;

void iniciarCamera() {
  camera_config_t config;
  config.ledc_channel = LEDC_CHANNEL_0;
  config.ledc_timer = LEDC_TIMER_0;
  config.pin_d0 = Y2_GPIO_NUM;
  config.pin_d1 = Y3_GPIO_NUM;
  config.pin_d2 = Y4_GPIO_NUM;
  config.pin_d3 = Y5_GPIO_NUM;
  config.pin_d4 = Y6_GPIO_NUM;
  config.pin_d5 = Y7_GPIO_NUM;
  config.pin_d6 = Y8_GPIO_NUM;
  config.pin_d7 = Y9_GPIO_NUM;
  config.pin_xclk = XCLK_GPIO_NUM;
  config.pin_pclk = PCLK_GPIO_NUM;
  config.pin_vsync = VSYNC_GPIO_NUM;
  config.pin_href = HREF_GPIO_NUM;
  config.pin_sscb_sda = SIOD_GPIO_NUM;
  config.pin_sscb_scl = SIOC_GPIO_NUM;
  config.pin_pwdn = PWDN_GPIO_NUM;
  config.pin_reset = RESET_GPIO_NUM;
  config.xclk_freq_hz = 20000000;
  config.pixel_format = PIXFORMAT_JPEG;

  if (psramFound()) {
    config.frame_size = FRAMESIZE_VGA; // 640x480
    config.jpeg_quality = 12;
    config.fb_count = 2;
    config.grab_mode = CAMERA_GRAB_LATEST;
    Serial.println("[CAM] PSRAM ativa! Modo de alta fluidez configurado.");
  } else {
    config.frame_size = FRAMESIZE_CIF;
    config.jpeg_quality = 12;
    config.fb_count = 1;
    Serial.println("[CAM] Alerta: PSRAM não encontrada. Usando modo econômico.");
  }

  esp_err_t err = esp_camera_init(&config);
  if (err != ESP_OK) {
    Serial.printf("[CAM] Erro ao inicializar câmera: 0x%x\n", err);
    return;
  }
}

// Handler HTTP do Streaming MJPEG
static esp_err_t stream_handler(httpd_req_t *req) {
  camera_fb_t * fb = NULL;
  esp_err_t res = ESP_OK;
  size_t _jpg_buf_len = 0;
  uint8_t * _jpg_buf = NULL;
  char part_buf[64];

  res = httpd_resp_set_type(req, _STREAM_CONTENT_TYPE);
  if (res != ESP_OK) return res;

  httpd_resp_set_hdr(req, "Access-Control-Allow-Origin", "*");

  while (true) {
    fb = esp_camera_fb_get();
    if (!fb) {
      res = ESP_FAIL;
    } else {
      _jpg_buf_len = fb->len;
      _jpg_buf = fb->buf;
    }

    if (res == ESP_OK) {
      res = httpd_resp_send_chunk(req, _STREAM_BOUNDARY, strlen(_STREAM_BOUNDARY));
    }
    if (res == ESP_OK) {
      size_t hlen = snprintf(part_buf, 64, _STREAM_PART, _jpg_buf_len);
      res = httpd_resp_send_chunk(req, part_buf, hlen);
    }
    if (res == ESP_OK) {
      res = httpd_resp_send_chunk(req, (const char *)_jpg_buf, _jpg_buf_len);
    }

    if (fb) {
      esp_camera_fb_return(fb);
      fb = NULL;
      _jpg_buf = NULL;
    } else {
      break;
    }

    if (res != ESP_OK) break;
  }
  return res;
}

// Rota HTTP para acionar o movimento do carrinho
static esp_err_t mover_handler(httpd_req_t *req) {
  if (SerialBT.connected(0)) {
    SerialBT.println("Andar_para_frente");
    httpd_resp_send(req, "Comando 'Andar_para_frente' enviado ao carrinho via BT!", HTTPD_RESP_USE_STRLEN);
  } else {
    httpd_resp_send_500(req);
    httpd_resp_send(req, "Erro: Bluetooth desconectado do carrinho.", HTTPD_RESP_USE_STRLEN);
  }
  return ESP_OK;
}

void iniciarServidorWeb() {
  httpd_config_t config = HTTPD_DEFAULT_CONFIG();
  config.server_port = 80;

  httpd_uri_t stream_uri = {
    .uri       = "/",
    .method    = HTTP_GET,
    .handler   = stream_handler,
    .user_ctx  = NULL
  };

  httpd_uri_t mover_uri = {
    .uri       = "/frente",
    .method    = HTTP_GET,
    .handler   = mover_handler,
    .user_ctx  = NULL
  };

  if (httpd_start(&stream_httpd, &config) == ESP_OK) {
    httpd_register_uri_handler(stream_httpd, &stream_uri);
    httpd_register_uri_handler(stream_httpd, &mover_uri);
    Serial.println("[HTTP] Servidor rodando na porta 80!");
  }
}

void setup() {
  Serial.begin(115200);
  delay(1000);

  iniciarCamera();

  // Conexão Wi-Fi
  WiFi.begin(ssid, password);
  Serial.print("[Wi-Fi] Conectando");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\n[Wi-Fi] Conectado!");
  Serial.print("[HTTP] Acesse o Stream em: http://");
  Serial.println(WiFi.localIP());

  iniciarServidorWeb();

  // Inicia Bluetooth em modo Master
  SerialBT.begin("ESP32_CAM_Master", true);
  Serial.println("[BT Master] Procurando e conectando em 'ESP32_Carrinho_Robo'...");
  
  if (SerialBT.connect(nomeRoboBT)) {
    Serial.println("[BT Master] Conectado com sucesso ao Carrinho!");
  } else {
    Serial.println("[BT Master] Falha na conexão inicial. Tentará reconectar no loop.");
  }
}

void loop() {
  // Mantém a conexão Bluetooth ativa
  if (!SerialBT.connected(0)) {
    static unsigned long ultimaTentativa = 0;
    if (millis() - ultimaTentativa > 5000) {
      ultimaTentativa = millis();
      Serial.println("[BT Master] Tentando reconectar ao carrinho...");
      SerialBT.connect(nomeRoboBT);
    }
  }

  // Escuta o retorno do carrinho ("PRONTO_PARA_FOTO") enviado pelo Bluetooth
  if (SerialBT.available()) {
    String resposta = SerialBT.readStringUntil('\n');
    resposta.trim();
    if (resposta == "PRONTO_PARA_FOTO") {
      Serial.println("\n[BT Feedback] Carrinho finalizou o movimento e está parado!");
    }
  }

  delay(10);
}
