[env:esp32cam]
platform = espressif32
board = esp32cam
framework = arduino

; Velocidade do Monitor Serial
monitor_speed = 115200
monitor_port = COM5
upload_port = COM5
upload_speed = 115200

; Configurações do Flash e Partição de Memória
board_build.f_flash = 80000000L
board_build.flash_mode = qio
board_build.partitions = huge_app.csv

; Habilita o uso da PSRAM (Fundamental para o Streaming)
build_flags = 
    -DBOARD_HAS_PSRAM
    -mfix-esp32-psram-cache-issue
