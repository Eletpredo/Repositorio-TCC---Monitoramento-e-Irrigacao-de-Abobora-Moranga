#include <Arduino.h>

// Definição dos pinos da Ponte H (sem '=', sem ';')
#define MotorA1 12
#define MotorA2 14
#define MotorB1 27
#define MotorB2 26

// Funções de movimentação
void Andar_frente() {
  digitalWrite(MotorA1, HIGH);
  digitalWrite(MotorA2, LOW);
  digitalWrite(MotorB1, HIGH);
  digitalWrite(MotorB2, LOW);
}

void Andar_tras() {
  digitalWrite(MotorA1, LOW);
  digitalWrite(MotorA2, HIGH);
  digitalWrite(MotorB1, LOW);
  digitalWrite(MotorB2, HIGH);
}

void girar_direita() {
  digitalWrite(MotorA1, HIGH);
  digitalWrite(MotorA2, LOW);
  digitalWrite(MotorB1, LOW);
  digitalWrite(MotorB2, HIGH);
}

void girar_esquerda() {
  digitalWrite(MotorA1, LOW);
  digitalWrite(MotorA2, HIGH);
  digitalWrite(MotorB1, HIGH);
  digitalWrite(MotorB2, LOW);
}

void parar() {
  digitalWrite(MotorA1, LOW);
  digitalWrite(MotorA2, LOW);
  digitalWrite(MotorB1, LOW);
  digitalWrite(MotorB2, LOW);
}

void setup() {
  // Configura os pinos como SAÍDA para acionar a ponte H
  pinMode(MotorA1, OUTPUT);
  pinMode(MotorA2, OUTPUT);
  pinMode(MotorB1, OUTPUT);
  pinMode(MotorB2, OUTPUT);
}

void loop() {
  Andar_frente();
  delay(2500);

  Andar_tras();
  delay(2500);

  girar_direita();
  delay(2500);

  girar_esquerda();
  delay(2500);

  parar();
  delay(10000);
}
